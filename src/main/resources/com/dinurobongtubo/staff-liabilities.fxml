<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinurobongtubo.StaffLiabilitiesController"
            stylesheets="@staff-liabilities.css, @student-dashboard.css"
            prefWidth="1200"
            prefHeight="760"
            styleClass="app-background, items-root">

    <!-- SIDEBAR (Unified across all Staff & Student Views) -->
    <left>
        <VBox prefWidth="255" minWidth="255" styleClass="sidebar">

            <!-- BRAND HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
                <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="brand-mark">
                    <Label text="HM" styleClass="brand-mark-text" style="-fx-font-weight: 800; -fx-font-size: 14px; -fx-text-fill: #FFFFFF;"/>
                </StackPane>
                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label text="HiramMate" styleClass="brand-name"/>
                    <Label text="STAFF PORTAL" styleClass="brand-caption"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- NAVIGATION MENU -->
            <VBox spacing="6" styleClass="navigation">
                <Label text="STAFF MENU" styleClass="menu-heading" mouseTransparent="true"/>

                <Button text="  ⊞   Dashboard"
                        onAction="#showDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  ◫   Items"
                        onAction="#showItems"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  ◷   Requests"
                        onAction="#showRequests"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  ⇄   Borrowers &amp; Returns"
                        onAction="#showBorrowersReturns"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  ⚠   Liabilities"
                        maxWidth="Infinity"
                        styleClass="nav-button, nav-button-active"
                        style="-fx-background-color: #B93838; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" mouseTransparent="true"/>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- STAFF PROFILE FOOTER -->
            <VBox spacing="8" styleClass="profile-container">
                <Label text="SIGNED IN AS" styleClass="menu-heading" mouseTransparent="true"/>

                <HBox spacing="11" alignment="CENTER_LEFT" styleClass="profile-card">
                    <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="profile-avatar">
                        <Label text="MS" styleClass="profile-initials"/>
                    </StackPane>

                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="staffNameLabel"
                               text="Staff Member"
                               styleClass="profile-name"/>
                        <Label fx:id="staffIdLabel"
                               text="Staff ID • Active"
                               styleClass="profile-details"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <Button text="Log Out"
                        onAction="#logout"
                        maxWidth="Infinity"
                        styleClass="logout-button"/>
            </VBox>

        </VBox>
    </left>

    <center>
        <VBox spacing="20" styleClass="main-area">

            <padding>
                <Insets top="30" right="32" bottom="30" left="32"/>
            </padding>

            <!-- PAGE TITLE -->
            <VBox spacing="5">

                <Label text="Student Liabilities"
                       styleClass="page-title"/>

                <Label text="Monitor penalties and outstanding student liabilities."
                       styleClass="page-subtitle"/>

            </VBox>

            <!-- SUMMARY CARDS -->
            <HBox spacing="14">

                <VBox spacing="8"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="PENDING LIABILITIES"
                           styleClass="summary-label"/>

                    <Label fx:id="pendingCountLabel"
                           text="₱0.00"
                           styleClass="summary-number"
                           style="-fx-text-fill: #1A1D20;"/>

                </VBox>

                <VBox spacing="8"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="OUTSTANDING AMOUNT"
                           styleClass="summary-label"/>

                    <Label fx:id="outstandingAmountLabel"
                           text="₱0.00"
                           styleClass="summary-number"
                           style="-fx-text-fill: #1A1D20;"/>

                </VBox>

                <VBox spacing="8"
                      styleClass="summary-card"
                      HBox.hgrow="ALWAYS">

                    <Label text="SETTLED LIABILITIES"
                           styleClass="summary-label"/>

                    <Label fx:id="settledCountLabel"
                           text="₱0.00"
                           styleClass="summary-number"
                           style="-fx-text-fill: #1A1D20;"/>

                </VBox>

            </HBox>

            <!-- LIABILITY TABLE -->
            <VBox spacing="14"
                  styleClass="section-card"
                  VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT" spacing="12">

                    <VBox spacing="4" HBox.hgrow="ALWAYS">

                        <Label text="Liability Records"
                               styleClass="section-title"/>

                        <Label text="Select a record to settle an outstanding liability."
                               styleClass="page-subtitle"/>

                    </VBox>

                    <Button text="Refresh"
                            onAction="#loadLiabilities"
                            styleClass="neutral-button"/>

                </HBox>

                <!-- SEARCH AND FILTER -->
                <HBox spacing="12">

                    <TextField fx:id="searchField"
                               promptText="Search liability ID, student, item..."
                               styleClass="search-field"
                               HBox.hgrow="ALWAYS"/>

                    <ComboBox fx:id="filterComboBox"
                              prefWidth="155"
                              styleClass="category-filter"
                              promptText="Filter status"/>

                </HBox>

                <!-- TABLE -->
                <TableView fx:id="liabilitiesTable"
                           styleClass="data-table"
                           VBox.vgrow="ALWAYS"
                           prefHeight="350">

                    <columns>

                        <TableColumn fx:id="liabilityIdColumn"
                                     text="Liability ID"
                                     prefWidth="100"/>

                        <TableColumn fx:id="studentColumn"
                                     text="Student"
                                     prefWidth="150"/>

                        <TableColumn fx:id="studentIdColumn"
                                     text="Student ID"
                                     prefWidth="105"/>

                        <TableColumn fx:id="itemColumn"
                                     text="Affected Item"
                                     prefWidth="145"/>

                        <TableColumn fx:id="reasonColumn"
                                     text="Violation Type"
                                     prefWidth="175"/>

                        <TableColumn fx:id="amountColumn"
                                     text="Amount"
                                     prefWidth="105"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="95"/>

                    </columns>

                    <placeholder>
                        <Label text="No liability records found."
                               styleClass="empty-message"/>
                    </placeholder>

                </TableView>

                <!-- ACTION BUTTONS -->
                <HBox alignment="CENTER_RIGHT" spacing="12">

                    <Button text="Settle Liability"
                            onAction="#settleLiability"
                            styleClass="primary-button"/>

                    <Button text="Calculate &amp; Assess Liability"
                            onAction="#openCalculateLiability"
                            styleClass="primary-button"/>

                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>