<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinurobongtubo.LiabilitiesController"
            stylesheets="@student-dashboard.css, @liabilities.css"
            prefWidth="1100"
            prefHeight="700"
            styleClass="app-background">

    <!-- SIDEBAR (100% Identical to BrowseItems, MyRequests, BorrowedReturns & StudentDashboard) -->
    <left>
        <VBox prefWidth="255" minWidth="255" styleClass="sidebar">

            <!-- BRAND HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
                <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="brand-mark">
                    <Label text="HM" styleClass="brand-mark-text" style="-fx-font-weight: 800; -fx-font-size: 14px; -fx-text-fill: #FFFFFF;"/>
                </StackPane>
                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label text="HiramMate" styleClass="brand-name"/>
                    <Label text="STUDENT PORTAL" styleClass="brand-caption"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- NAVIGATION MENU -->
            <VBox spacing="6" styleClass="navigation">
                <Label text="STUDENT MENU" styleClass="menu-heading" mouseTransparent="true"/>

                <Button fx:id="btnDashboard"
                        text="  ⊞   Dashboard"
                        onAction="#showDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="btnBrowseItems"
                        text="  ◫   Browse Items"
                        onAction="#showBrowseItems"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="btnMyRequests"
                        text="  ◷   My Requests"
                        onAction="#showMyRequests"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="btnBorrowedReturns"
                        text="  ⇄   Borrowed &amp; Returns"
                        onAction="#showBorrowedReturns"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="btnLiabilities"
                        text="  ⚠   Liabilities"
                        maxWidth="Infinity"
                        styleClass="nav-button, nav-button-active"
                        style="-fx-background-color: #B93838; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" mouseTransparent="true"/>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- USER PROFILE FOOTER -->
            <VBox spacing="8" styleClass="profile-container">
                <Label text="SIGNED IN AS" styleClass="menu-heading" mouseTransparent="true"/>

                <HBox spacing="11" alignment="CENTER_LEFT" styleClass="profile-card">
                    <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="profile-avatar">
                        <Label fx:id="profileInitials" text="AS" styleClass="profile-initials"/>
                    </StackPane>

                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="profileName"
                               text="Student Name"
                               styleClass="profile-name"/>
                        <Label fx:id="profileDetails"
                               text="Student ID • Department"
                               styleClass="profile-details"
                               wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="main-scroll"
                    hbarPolicy="NEVER">

            <VBox spacing="25" styleClass="main-content">

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="5">
                        <Label text="Liabilities"
                               styleClass="page-title"/>

                        <Label text="View your outstanding balances and borrowing-related charges."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                   <Button text="Download Statement"
        onAction="#downloadStatement"
        styleClass="secondary-button"/>
        
                </HBox>

                <!-- SUMMARY CARDS -->
                <GridPane hgap="15" vgap="15">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"
                                           hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.33"
                                           hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.34"
                                           hgrow="ALWAYS"/>
                    </columnConstraints>

                    <!-- TOTAL OUTSTANDING -->
                    <VBox GridPane.columnIndex="0"
                          spacing="12"
                          styleClass="summary-card">

                        <Label text="TOTAL OUTSTANDING"
                               styleClass="summary-label"/>

                        <Label fx:id="totalOutstandingLabel"
                               text="₱0.00"
                               styleClass="amount-value"/>

                        <Label text="Amount currently due"
                               styleClass="summary-description"/>
                    </VBox>

                    <!-- PENDING CHARGES -->
                    <VBox GridPane.columnIndex="1"
                          spacing="12"
                          styleClass="summary-card">

                        <Label text="PENDING CHARGES"
                               styleClass="summary-label"/>

                        <Label fx:id="pendingChargesLabel"
                               text="₱0.00"
                               styleClass="amount-value"/>

                        <Label text="Awaiting confirmation"
                               styleClass="summary-description"/>
                    </VBox>

                    <!-- SETTLED -->
                    <VBox GridPane.columnIndex="2"
                          spacing="12"
                          styleClass="summary-card">

                        <Label text="SETTLED"
                               styleClass="summary-label"/>

                        <Label fx:id="settledLabel"
                               text="₱0.00"
                               styleClass="amount-value"/>

                        <Label text="Previously settled charges"
                               styleClass="summary-description"/>
                    </VBox>

                </GridPane>

                <!-- PAYMENT NOTICE -->
                <HBox spacing="15"
                      alignment="CENTER_LEFT"
                      styleClass="notice-card">

                    <Label text="!"
                           styleClass="notice-icon"/>

                    <VBox spacing="5">
                        <Label text="Outstanding balance"
                               styleClass="notice-title"/>

                        <Label fx:id="noticeDescription"
                               text="Loading outstanding balance..."
                               wrapText="true"
                               styleClass="notice-description"/>
                    </VBox>
                </HBox>

                <!-- LIABILITY RECORDS -->
                <VBox spacing="18" styleClass="records-panel">

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="5">
                            <Label text="Liability Records"
                                   styleClass="panel-title"/>

                            <Label text="A history of charges associated with your borrowed items."
                                   styleClass="panel-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <ComboBox fx:id="statusFilter"
                                  promptText="All statuses"
                                  styleClass="filter-combo"
                                  prefWidth="150"/>
                    </HBox>

                    <!-- SEARCH -->
                    <TextField fx:id="searchField"
                               promptText="Search by item or reference number..."
                               styleClass="search-field"/>

                    <!-- TABLE -->
                    <TableView fx:id="liabilitiesTable"
                               prefHeight="310"
                               styleClass="records-table">

                        <columns>

                            <TableColumn fx:id="referenceColumn"
                                         text="REFERENCE"
                                         prefWidth="110"/>

                            <TableColumn fx:id="itemColumn"
                                         text="ITEM"
                                         prefWidth="155"/>

                            <TableColumn fx:id="reasonColumn"
                                         text="REASON"
                                         prefWidth="150"/>

                            <TableColumn fx:id="dateColumn"
                                         text="DATE"
                                         prefWidth="110"/>

                            <TableColumn fx:id="amountColumn"
                                         text="AMOUNT"
                                         prefWidth="100"/>

                            <TableColumn fx:id="statusColumn"
                                         text="STATUS"
                                         prefWidth="120"/>

                        </columns>

                        <placeholder>
                            <VBox alignment="CENTER" spacing="8">
                                <Label text="No liability records found"
                                       styleClass="empty-title"/>

                                <Label text="Your liability records will appear here."
                                       styleClass="empty-description"/>
                            </VBox>
                        </placeholder>

                    </TableView>

                    <!-- TABLE FOOTER -->
                    <HBox alignment="CENTER_LEFT">

                        <Label fx:id="recordsFooter"
                               text="Loading records..."
                               styleClass="table-footer"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label text="Live database"
                               styleClass="table-footer"/>

                    </HBox>

                </VBox>

                <!-- GUIDELINES -->
                <VBox spacing="12" styleClass="guidelines-panel">

                    <Label text="Important Information"
                           styleClass="panel-title"/>

                    <Label text="• Charges may apply when borrowed items are damaged, lost, or returned late, according to school policy."
                           wrapText="true"
                           styleClass="guideline-text"/>

                    <Label text="• Pending charges must be verified by the authorized property office."
                           wrapText="true"
                           styleClass="guideline-text"/>

                    <Label text="• Contact the property office if you believe a liability record is incorrect."
                           wrapText="true"
                           styleClass="guideline-text"/>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>