<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/27"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.dinurobongtubo.MyRequestsController"
    stylesheets="@student-dashboard.css, @my-requests.css"
    prefWidth="1100"
    prefHeight="700"
    styleClass="app-background">

    <!-- SIDEBAR (100% Identical to BrowseItems.fxml & StudentDashboard.fxml) -->
    <left>
        <VBox prefWidth="255" minWidth="255" styleClass="sidebar">

            <!-- BRAND HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
                <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="brand-mark">
                    <Label text="HM" styleClass="brand-mark-text" style="-fx-font-weight: 800; -fx-font-size: 14px; -fx-text-fill: #FFFFFF;"/>
                </StackPane>
                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label text="HiramMate" styleClass="brand-name"/>
                    <Label text="STUDENT PORTAL" styleClass="brand-caption"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- NAVIGATION MENU -->
            <VBox spacing="6" styleClass="navigation">
                <Label text="STUDENT MENU" styleClass="menu-heading" mouseTransparent="true"/>

                <Button fx:id="btnDashboard"
                        text="  ⊞   Dashboard"
                        onAction="#showDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="btnBrowseItems"
                        text="  ◫   Browse Items"
                        onAction="#showBrowseItems"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="btnMyRequests"
                        text="  ◷   My Requests"
                        maxWidth="Infinity"
                        styleClass="nav-button, nav-button-active"
                        style="-fx-background-color: #B93838; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>

                <Button fx:id="btnBorrowedReturns"
                        text="  ⇄   Borrowed &amp; Returns"
                        onAction="#showBorrowedReturns"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="btnLiabilities"
                        text="  ⚠   Liabilities"
                        onAction="#showLiabilities"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" mouseTransparent="true"/>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- USER PROFILE FOOTER -->
            <VBox spacing="8" styleClass="profile-container">
                <Label text="SIGNED IN AS" styleClass="menu-heading" mouseTransparent="true"/>

                <HBox spacing="11" alignment="CENTER_LEFT" styleClass="profile-card">
                    <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="profile-avatar">
                        <Label fx:id="profileInitials" text="AS" styleClass="profile-initials"/>
                    </StackPane>

                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="profileName"
                               text="Student Name"
                               styleClass="profile-name"/>
                        <Label fx:id="profileDetails"
                               text="Student ID • Department"
                               styleClass="profile-details"
                               wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="main-scroll">

            <VBox spacing="25"
                  styleClass="main-content">

                <!-- PAGE HEADER -->
                <HBox alignment="CENTER_LEFT">

                    <VBox spacing="5">
                        <Label text="My Requests"
                               styleClass="page-title"/>
                        <Label text="Track approval progress, pickup schedules, and past borrow requests."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="+ New Request"
                            onAction="#showBrowseItems"
                            styleClass="primary-button"/>

                </HBox>

                <!-- REQUESTS PANEL -->
                <VBox spacing="18"
                      styleClass="requests-panel">

                    <!-- STATUS FILTERS -->
                    <HBox spacing="8"
                          alignment="CENTER_LEFT"
                          styleClass="filter-row">

                        <Button text="All Requests"
                                onAction="#showAllRequests"
                                styleClass="request-filter request-filter-active"/>

                        <Button text="Pending"
                                onAction="#showPendingRequests"
                                styleClass="request-filter"/>

                        <Button text="Reserved"
                                onAction="#showReservedRequests"
                                styleClass="request-filter"/>

                        <Button text="Approved"
                                onAction="#showApprovedRequests"
                                styleClass="request-filter"/>

                        <Button text="Returned / Cancelled"
                                onAction="#showClosedRequests"
                                styleClass="request-filter"/>

                    </HBox>

                    <!-- SEARCH FIELD -->
                    <TextField fx:id="searchField"
                               promptText="Search by request ID or item name..."
                               styleClass="search-field"/>

                    <!-- REQUESTS TABLE -->
                    <TableView fx:id="requestsTable"
                               prefHeight="420"
                               styleClass="requests-table">

                        <columns>

                            <TableColumn fx:id="requestIdColumn"
                                         text="Request ID"
                                         prefWidth="105"/>

                            <TableColumn fx:id="itemColumn"
                                         text="Item"
                                         prefWidth="150"/>

                            <TableColumn fx:id="purposeColumn"
                                         text="Purpose"
                                         prefWidth="190"/>

                            <TableColumn fx:id="pickupDateColumn"
                                         text="Pickup Date"
                                         prefWidth="105"/>

                            <TableColumn fx:id="dueDateColumn"
                                         text="Due Date"
                                         prefWidth="100"/>

                            <TableColumn fx:id="statusColumn"
                                         text="Status"
                                         prefWidth="110"/>

                            <TableColumn fx:id="actionColumn"
                                         text="Action"
                                         prefWidth="90"/>

                        </columns>

                    </TableView>

                    <!-- TABLE FOOTER -->
                    <HBox alignment="CENTER_LEFT">

                        <Label fx:id="tableFooterLabel"
                               text="Showing 0 requests"
                               styleClass="table-footer"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="tableCountLabel"
                               text="0 - 0 of 0"
                               styleClass="table-footer"/>

                    </HBox>

                </VBox>

            </VBox>

        </ScrollPane>
    </center>

</BorderPane>