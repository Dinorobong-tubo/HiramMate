<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
    xmlns="http://javafx.com/javafx/27"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.dinurobongtubo.BrowseItemsController"
    stylesheets="@student-dashboard.css, @browse-items.css"
    prefWidth="1100"
    prefHeight="700"
    styleClass="app-background">

    <!-- SIDEBAR (100% Identical to MyRequests.fxml & StudentDashboard.fxml) -->
    <left>
        <VBox prefWidth="255" minWidth="255" styleClass="sidebar">

            <!-- BRAND HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
                <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="brand-mark">
                    <Label text="HM" styleClass="brand-mark-text" style="-fx-font-weight: 800; -fx-font-size: 14px; -fx-text-fill: #FFFFFF;"/>
                </StackPane>
                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label text="HiramMate" styleClass="brand-name"/>
                    <Label text="STUDENT PORTAL" styleClass="brand-caption"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- NAVIGATION MENU -->
            <VBox spacing="6" styleClass="navigation">
                <Label text="STUDENT MENU" styleClass="menu-heading" mouseTransparent="true"/>

                <Button fx:id="btnDashboard"
                        text="  ⊞   Dashboard"
                        onAction="#showDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="btnBrowseItems"
                        text="  ◫   Browse Items"
                        maxWidth="Infinity"
                        styleClass="nav-button, nav-button-active"
                        style="-fx-background-color: #B93838; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>

                <Button fx:id="btnMyRequests"
                        text="  ◷   My Requests"
                        onAction="#showMyRequests"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="btnBorrowedReturns"
                        text="  ⇄   Borrowed &amp; Returns"
                        onAction="#showBorrowedReturns"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="btnLiabilities"
                        text="  ⚠   Liabilities"
                        onAction="#showLiabilities"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" mouseTransparent="true"/>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- USER PROFILE FOOTER -->
            <VBox spacing="8" styleClass="profile-container">
                <Label text="SIGNED IN AS" styleClass="menu-heading" mouseTransparent="true"/>

                <HBox spacing="11" alignment="CENTER_LEFT" styleClass="profile-card">
                    <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="profile-avatar">
                        <Label fx:id="profileInitials" text="AS" styleClass="profile-initials"/>
                    </StackPane>

                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="profileName"
                               text="Student Name"
                               styleClass="profile-name"/>
                        <Label fx:id="profileDetails"
                               text="Student ID • Department"
                               styleClass="profile-details"
                               wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>

        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true"
                    styleClass="main-scroll"
                    hbarPolicy="NEVER">

            <VBox spacing="25"
                  styleClass="main-content">

                <!-- PAGE HEADER -->
                <HBox alignment="CENTER_LEFT"
                      spacing="15">

                    <VBox spacing="5">

                        <Label text="Browse items"
                               styleClass="page-title"/>

                        <Label text="Select available campus equipment and submit a borrow request."
                               styleClass="page-subtitle"/>

                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="+ Request custom item"
                            onAction="#showComingSoon"
                            styleClass="primary-button"/>

                </HBox>

                <!-- SEARCH AND CATEGORY FILTERS -->
                <VBox spacing="12"
                      styleClass="filter-panel">

                    <TextField fx:id="searchField"
                               promptText="Search by item name, code, or description..."
                               styleClass="search-field"/>

                    <!-- CATEGORY FILTERS -->
                    <HBox spacing="8"
                          alignment="CENTER_LEFT">

                        <Button text="All"
                                onAction="#showAllItems"
                                styleClass="category-button category-active"/>

                        <Button text="Electronics"
                                onAction="#showElectronics"
                                styleClass="category-button"/>

                        <Button text="Laboratory"
                                onAction="#showLaboratory"
                                styleClass="category-button"/>

                        <Button text="Engineering"
                                onAction="#showEngineering"
                                styleClass="category-button"/>

                        <Button text="Sports"
                                onAction="#showSports"
                                styleClass="category-button"/>

                    </HBox>

                </VBox>

                <!-- DATABASE ITEM CATALOG -->
                <FlowPane fx:id="catalogGrid"
                          hgap="16"
                          vgap="16"
                          prefWrapLength="850"
                          styleClass="catalog-grid"/>

            </VBox>

        </ScrollPane>
    </center>

</BorderPane>