<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinurobongtubo.StudentDashboardController"
            stylesheets="@student-dashboard.css"
            prefWidth="1100"
            prefHeight="700"
            styleClass="app-background">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="255" minWidth="255" styleClass="sidebar">

            <!-- BRAND HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
                <StackPane prefWidth="36" prefHeight="36"
                           minWidth="36" minHeight="36"
                           styleClass="brand-mark">
                    <Label text="HM"
                           styleClass="brand-mark-text"
                           style="-fx-font-weight: 800; -fx-font-size: 14px; -fx-text-fill: #FFFFFF;"/>
                </StackPane>

                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label text="HiramMate" styleClass="brand-name"/>
                    <Label text="STUDENT PORTAL" styleClass="brand-caption"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- NAVIGATION MENU -->
            <VBox spacing="6" styleClass="navigation">
                <Label text="STUDENT MENU"
                       styleClass="menu-heading"
                       mouseTransparent="true"/>

                <Button fx:id="dashboardBtn"
                        text="  ⊞   Dashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button, nav-button-active"
                        style="-fx-background-color: #B93838; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>

                <Button fx:id="browseBtn"
                        text="  ◫   Browse Items"
                        onAction="#showBrowseItems"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="requestsBtn"
                        text="  ◷   My Requests"
                        onAction="#showMyRequests"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="borrowedBtn"
                        text="  ⇄   Borrowed &amp; Returns"
                        onAction="#showBorrowedReturns"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button fx:id="liabilitiesBtn"
                        text="  ⚠   Liabilities"
                        onAction="#showLiabilities"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" mouseTransparent="true"/>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- USER PROFILE FOOTER -->
            <VBox spacing="8" styleClass="profile-container">

                <Label text="SIGNED IN AS"
                       styleClass="menu-heading"
                       mouseTransparent="true"/>

                <HBox spacing="11" alignment="CENTER_LEFT" styleClass="profile-card">
                    <StackPane prefWidth="36" prefHeight="36"
                               minWidth="36" minHeight="36"
                               styleClass="profile-avatar">
                        <Label fx:id="profileInitials"
                               text="ST"
                               styleClass="profile-initials"/>
                    </StackPane>

                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="profileName"
                               text="Student Name"
                               styleClass="profile-name"/>

                        <Label fx:id="profileDetails"
                               text="Student ID • Department"
                               styleClass="profile-details"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <!-- LOG OUT BUTTON -->
                <Button text="Log Out"
              onAction="#handleLogout"
              maxWidth="Infinity"
              prefHeight="48"
              minHeight="48"
              style="-fx-background-color: #FFFFFF;
               -fx-background-radius: 12;
               -fx-border-color: #E1E5E9;
               -fx-border-width: 1.5;
               -fx-border-radius: 12;
               -fx-text-fill: #B93838;
               -fx-font-size: 16px;
               -fx-font-weight: bold;
               -fx-alignment: CENTER;
               -fx-padding: 8 12;
               -fx-cursor: hand;"/>

            </VBox>

        </VBox>
    </left>

    <!-- MAIN AREA -->
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="main-scroll">

            <VBox spacing="25" styleClass="main-content">

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Student Dashboard"
                               styleClass="page-title"/>

                        <Label fx:id="welcomeLabel"
                               text="Welcome back! Track your campus equipment borrows and requests."
                               styleClass="page-subtitle"
                               wrapText="true"/>
                    </VBox>

                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <TextField promptText="Search items..."
                                   prefWidth="185"
                                   styleClass="search-field"/>

                        <Button text="+ Borrow item"
                                onAction="#showBrowseItems"
                                styleClass="primary-button"/>
                    </HBox>
                </HBox>

                <!-- WELCOME BANNER -->
                <HBox alignment="CENTER_LEFT"
                      styleClass="welcome-banner">
                    <VBox spacing="7" HBox.hgrow="ALWAYS">
                        <Label text="Your campus essentials, all in one place."
                               styleClass="banner-title"/>

                        <Label text="Browse equipment, manage your requests, and keep track of your borrowed items."
                               styleClass="banner-description"
                               wrapText="true"/>
                    </VBox>

                    <Label text="HM"
                           styleClass="banner-mark"/>
                </HBox>

                <!-- SUMMARY -->
                <VBox spacing="13">
                    <Label text="BORROWING OVERVIEW"
                           styleClass="eyebrow"/>

                    <GridPane hgap="13" vgap="13">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="25" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <VBox spacing="12"
                              styleClass="stat-card"
                              GridPane.columnIndex="0">
                            <Label text="CURRENTLY BORROWED"
                                   styleClass="stat-label"/>
                            <Label fx:id="borrowedCount"
                                   text="0"
                                   styleClass="stat-value"/>
                            <Label text="Items in your possession"
                                   styleClass="stat-description"/>
                        </VBox>

                        <VBox spacing="12"
                              styleClass="stat-card"
                              GridPane.columnIndex="1">
                            <Label text="PENDING REQUESTS"
                                   styleClass="stat-label"/>
                            <Label fx:id="pendingCount"
                                   text="0"
                                   styleClass="stat-value"/>
                            <Label text="Awaiting approval"
                                   styleClass="stat-description"/>
                        </VBox>

                        <VBox spacing="12"
                              styleClass="stat-card"
                              GridPane.columnIndex="2">
                            <Label text="OVERDUE ITEMS"
                                   styleClass="stat-label"/>
                            <Label fx:id="overdueCount"
                                   text="0"
                                   styleClass="stat-value"/>
                            <Label text="Past their due date"
                                   styleClass="stat-description"/>
                        </VBox>

                        <VBox spacing="12"
                              styleClass="stat-card"
                              GridPane.columnIndex="3">
                            <Label text="RESERVED ITEMS"
                                   styleClass="stat-label"/>
                            <Label fx:id="reservedCount"
                                   text="0"
                                   styleClass="stat-value"/>
                            <Label text="Approved reservations"
                                   styleClass="stat-description"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- ACTIVE RECORDS -->
                <VBox spacing="17" styleClass="content-card">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="My active borrows &amp; requests"
                                   styleClass="section-title"/>
                            <Label text="Keep track of your latest transactions."
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <Button text="View all requests  →"
                                onAction="#showMyRequests"
                                styleClass="text-button"/>
                    </HBox>

                    <GridPane styleClass="table-header">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="20"/>
                            <ColumnConstraints percentWidth="17"/>
                            <ColumnConstraints percentWidth="18"/>
                        </columnConstraints>

                        <Label text="ITEM" GridPane.columnIndex="0"/>
                        <Label text="CATEGORY" GridPane.columnIndex="1"/>
                        <Label text="DUE DATE" GridPane.columnIndex="2"/>
                        <Label text="STATUS" GridPane.columnIndex="3"/>
                        <Label text="ACTION" GridPane.columnIndex="4"/>
                    </GridPane>

                    <Separator styleClass="soft-separator"/>

                    <VBox alignment="CENTER" spacing="8"
                          styleClass="empty-state">
                        <Label text="No active transactions"
                               styleClass="empty-title"/>

                        <Label fx:id="activeRecordsMessage"
                               text="Your active borrows and pending requests will appear here."
                               styleClass="empty-message"
                               wrapText="true"/>

                        <Button text="Browse available items"
                                onAction="#showBrowseItems"
                                styleClass="secondary-button"/>
                    </VBox>
                </VBox>

                <!-- AVAILABLE ITEMS -->
                <VBox spacing="17" styleClass="content-card">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Explore campus equipment"
                                   styleClass="section-title"/>
                            <Label text="Find the equipment you need for your academic activities."
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <Button text="Browse catalog  →"
                                onAction="#showBrowseItems"
                                styleClass="text-button"/>
                    </HBox>

                    <GridPane hgap="13" vgap="13">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                            <ColumnConstraints percentWidth="25"/>
                        </columnConstraints>

                        <VBox spacing="10"
                              styleClass="item-preview-card"
                              GridPane.columnIndex="0">
                            <Label text="01" styleClass="item-number"/>
                            <Label text="Electronics"
                                   styleClass="item-name"/>
                            <Label text="Explore available electronic equipment."
                                   styleClass="item-description"
                                   wrapText="true"/>
                        </VBox>

                        <VBox spacing="10"
                              styleClass="item-preview-card"
                              GridPane.columnIndex="1">
                            <Label text="02" styleClass="item-number"/>
                            <Label text="Tools &amp; Equipment"
                                   styleClass="item-name"/>
                            <Label text="Find tools for your school activities."
                                   styleClass="item-description"
                                   wrapText="true"/>
                        </VBox>

                        <VBox spacing="10"
                              styleClass="item-preview-card"
                              GridPane.columnIndex="2">
                            <Label text="03" styleClass="item-number"/>
                            <Label text="Learning Materials"
                                   styleClass="item-name"/>
                            <Label text="Browse useful academic resources."
                                   styleClass="item-description"
                                   wrapText="true"/>
                        </VBox>

                        <VBox spacing="10"
                              styleClass="item-preview-card"
                              GridPane.columnIndex="3">
                            <Label text="04" styleClass="item-number"/>
                            <Label text="Other Items"
                                   styleClass="item-name"/>
                            <Label text="Discover more campus resources."
                                   styleClass="item-description"
                                   wrapText="true"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- LIABILITY NOTE -->
                <HBox alignment="CENTER_LEFT"
                      spacing="15"
                      styleClass="liability-strip">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Need to check your account?"
                               styleClass="section-title"/>
                        <Label text="Review your account liabilities and clearance information."
                               styleClass="section-subtitle"/>
                    </VBox>

                    <Button text="View liabilities"
                            onAction="#showLiabilities"
                            styleClass="secondary-button"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
