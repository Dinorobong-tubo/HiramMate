<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinurobongtubo.StaffDashboardController"
            prefWidth="1200.0"
            prefHeight="760.0"
            stylesheets="@staff-dashboard.css, @student-dashboard.css"
            styleClass="app-background, dashboard-root">

    <!-- SIDEBAR (100% Identical to all Staff & Student Views) -->
    <left>
        <VBox prefWidth="255" minWidth="255" styleClass="sidebar">

            <!-- BRAND HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
                <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="brand-mark">
                    <Label text="HM" styleClass="brand-mark-text" style="-fx-font-weight: 800; -fx-font-size: 14px; -fx-text-fill: #FFFFFF;"/>
                </StackPane>
                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label text="HiramMate" styleClass="brand-name"/>
                    <Label text="STAFF PORTAL" styleClass="brand-caption"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- NAVIGATION MENU -->
            <VBox spacing="6" styleClass="navigation">
                <Label text="STAFF MENU" styleClass="menu-heading" mouseTransparent="true"/>

                <Button text="  ⊞   Dashboard"
                        onAction="#showDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button, nav-button-active"
                        style="-fx-background-color: #B93838; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>

                <Button text="  ◫   Items"
                        onAction="#showItems"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  ◷   Requests"
                        onAction="#showRequests"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  ⇄   Borrowers &amp; Returns"
                        onAction="#showBorrowersReturns"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  ⚠   Liabilities"
                        onAction="#showLiabilities"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" mouseTransparent="true"/>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- STAFF PROFILE FOOTER -->
            <VBox spacing="8" styleClass="profile-container">
                <Label text="SIGNED IN AS" styleClass="menu-heading" mouseTransparent="true"/>

                <HBox spacing="11" alignment="CENTER_LEFT" styleClass="profile-card">
                    <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="profile-avatar">
                        <Label text="MS" styleClass="profile-initials"/>
                    </StackPane>

                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="staffNameLabel"
                               text="Staff Member"
                               styleClass="profile-name"/>
                        <Label fx:id="staffIdLabel"
                               text="Staff ID • Active"
                               styleClass="profile-details"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <Button text="Log Out"
                        onAction="#logout"
                        maxWidth="Infinity"
                        styleClass="logout-button"/>
            </VBox>

        </VBox>
    </left>

    <!-- MAIN DASHBOARD -->
    <center>
        <VBox spacing="20" styleClass="main-area">

            <padding>
                <Insets top="28" right="30" bottom="25" left="30"/>
            </padding>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <Label text="Staff Dashboard"
                       styleClass="page-title"
                       HBox.hgrow="ALWAYS"/>

                <TextField fx:id="searchField"
                           promptText="Search items or borrowers"
                           prefWidth="280"
                           styleClass="search-field"/>
            </HBox>

            <!-- SUMMARY CARDS -->
            <HBox spacing="14" styleClass="stats-row">

                <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label text="Available" styleClass="stat-label"/>
                    <Label fx:id="availableLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label text="Borrowed" styleClass="stat-label"/>
                    <Label fx:id="borrowedLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label text="Overdue" styleClass="stat-label"/>
                    <Label fx:id="overdueLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label text="Reserved" styleClass="stat-label"/>
                    <Label fx:id="reservedLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label text="Pending" styleClass="stat-label"/>
                    <Label fx:id="pendingLabel"
                           text="0"
                           styleClass="stat-value"/>
                </VBox>

            </HBox>

            <!-- INCOMING REQUESTS -->
            <VBox spacing="12" styleClass="section">

                <HBox alignment="CENTER_LEFT">
                    <Label text="Incoming borrower requests"
                           styleClass="section-title"
                           HBox.hgrow="ALWAYS"/>

                    <Label text="Review and process student requests"
                           styleClass="section-hint"/>
                </HBox>

                <TableView fx:id="requestsTable"
                           prefHeight="250"
                           styleClass="requests-table">

                    <columns>
                        <TableColumn fx:id="borrowerColumn"
                                     text="Borrower (Student)"
                                     prefWidth="220"/>

                        <TableColumn fx:id="itemColumn"
                                     text="Requested Item"
                                     prefWidth="170"/>

                        <TableColumn fx:id="dueDateColumn"
                                     text="Due Date"
                                     prefWidth="105"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="110"/>

                        <TableColumn fx:id="actionColumn"
                                     text="Staff Decision"
                                     prefWidth="170"/>
                    </columns>

                    <placeholder>
                        <Label text="No borrower requests found."
                               styleClass="empty-message"/>
                    </placeholder>

                </TableView>
            </VBox>

            <!-- ACTIVE BORROWERS -->
            <VBox spacing="12" styleClass="section">

                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="●" styleClass="live-indicator"/>

                    <Label text="Active borrowers monitor"
                           styleClass="section-title"
                           HBox.hgrow="ALWAYS"/>

                    <Button text="Open Full Monitor →"
                            onAction="#showBorrowersReturns"
                            styleClass="outline-button"/>
                </HBox>

                <ScrollPane fitToWidth="true"
                            hbarPolicy="NEVER"
                            prefHeight="190"
                            styleClass="borrower-scroll">

                    <content>
                        <HBox fx:id="activeBorrowersContainer"
                              spacing="14"
                              styleClass="borrower-container"/>
                    </content>

                </ScrollPane>

                <Label fx:id="borrowerEmptyLabel"
                       text="No active borrowers at the moment."
                       styleClass="empty-message"
                       visible="false"
                       managed="false"/>

            </VBox>

        </VBox>
    </center>

</BorderPane>