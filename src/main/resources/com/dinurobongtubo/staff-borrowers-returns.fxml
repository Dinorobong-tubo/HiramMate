<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/27"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinurobongtubo.StaffBorrowersReturnsController"
            stylesheets="@student-dashboard.css, @staff-borrowers-returns.css"
            prefWidth="1200" prefHeight="760"
            styleClass="app-background, page">

    <!-- SIDEBAR (Matches StaffDashboard.fxml, StaffItems.fxml, StaffRequests.fxml & Student Views) -->
    <left>
        <VBox prefWidth="255" minWidth="255" styleClass="sidebar">

            <!-- BRAND HEADER -->
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="brand">
                <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="brand-mark">
                    <Label text="HM" styleClass="brand-mark-text" style="-fx-font-weight: 800; -fx-font-size: 14px; -fx-text-fill: #FFFFFF;"/>
                </StackPane>
                <VBox spacing="1" alignment="CENTER_LEFT">
                    <Label text="HiramMate" styleClass="brand-name"/>
                    <Label text="STAFF PORTAL" styleClass="brand-caption"/>
                </VBox>
            </HBox>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- NAVIGATION MENU -->
            <VBox spacing="6" styleClass="navigation">
                <Label text="STAFF MENU" styleClass="menu-heading" mouseTransparent="true"/>

                <Button text="  ⊞   Dashboard"
                        onAction="#showDashboard"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  ◫   Items"
                        onAction="#showItems"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  ◷   Requests"
                        onAction="#showRequests"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>

                <Button text="  ⇄   Borrowers &amp; Returns"
                        maxWidth="Infinity"
                        styleClass="nav-button, nav-button-active"
                        style="-fx-background-color: #B93838; -fx-text-fill: #FFFFFF; -fx-font-weight: bold;"/>

                <Button text="  ⚠   Liabilities"
                        onAction="#showLiabilities"
                        maxWidth="Infinity"
                        styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" mouseTransparent="true"/>

            <Separator styleClass="sidebar-divider" mouseTransparent="true"/>

            <!-- STAFF PROFILE FOOTER -->
            <VBox spacing="8" styleClass="profile-container">
                <Label text="SIGNED IN AS" styleClass="menu-heading" mouseTransparent="true"/>

                <HBox spacing="11" alignment="CENTER_LEFT" styleClass="profile-card">
                    <StackPane prefWidth="36" prefHeight="36" minWidth="36" minHeight="36" styleClass="profile-avatar">
                        <Label text="MS" styleClass="profile-initials"/>
                    </StackPane>

                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label fx:id="staffNameLabel"
                               text="Staff Name"
                               styleClass="profile-name"/>
                        <Label fx:id="staffIdLabel"
                               text="Staff ID • Active"
                               styleClass="profile-details"
                               wrapText="true"/>
                    </VBox>
                </HBox>

                <Button text="Log Out"
                        onAction="#logout"
                        maxWidth="Infinity"
                        styleClass="logout-button"/>
            </VBox>

        </VBox>
    </left>

    <center>
        <VBox spacing="22" styleClass="main-content">
            <padding>
                <Insets top="30" right="32" bottom="30" left="32"/>
            </padding>

            <VBox spacing="6">
                <Label text="Borrowers &amp; Returns"
                       styleClass="page-title"/>
                <Label text="Monitor active borrowers and process returned items."
                       styleClass="page-subtitle"/>
            </VBox>

            <HBox spacing="16">
                <VBox spacing="8" styleClass="summary-card">
                    <Label text="ACTIVE BORROWERS" styleClass="summary-label"/>
                    <Label fx:id="activeCountLabel" text="0"
                           styleClass="summary-number"/>
                </VBox>

                <VBox spacing="8" styleClass="summary-card">
                    <Label text="OVERDUE RETURNS" styleClass="summary-label"/>
                    <Label fx:id="overdueCountLabel" text="0"
                           styleClass="summary-number-danger"/>
                </VBox>
            </HBox>

            <VBox spacing="14" styleClass="table-card">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Borrow Records" styleClass="section-title"/>
                        <Label text="Select a record to process its return."
                               styleClass="page-subtitle"/>
                    </VBox>

                    <Button text="Refresh" onAction="#loadBorrowRecords"
                            styleClass="secondary-button"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField"
                               promptText="Search borrower, student ID, item..."
                               HBox.hgrow="ALWAYS"/>

                    <ComboBox fx:id="filterComboBox"
                              prefWidth="160"
                              promptText="Filter status"/>
                </HBox>

                <TableView fx:id="borrowersTable"
                           VBox.vgrow="ALWAYS"
                           prefHeight="390">

                    <columns>
                        <TableColumn fx:id="recordIdColumn"
                                     text="Record ID" prefWidth="85"/>

                        <TableColumn fx:id="borrowerColumn"
                                     text="Borrower" prefWidth="145"/>

                        <TableColumn fx:id="studentIdColumn"
                                     text="Student ID" prefWidth="105"/>

                        <TableColumn fx:id="itemColumn"
                                     text="Item" prefWidth="140"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Qty" prefWidth="55"/>

                        <TableColumn fx:id="borrowDateColumn"
                                     text="Borrow Date" prefWidth="105"/>

                        <TableColumn fx:id="dueDateColumn"
                                     text="Due Date" prefWidth="105"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status" prefWidth="95"/>
                    </columns>

                    <placeholder>
                        <Label text="No borrow records found."/>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="12">
                    <Label text="Select a record before processing a return."
                           styleClass="helper-text"/>
                    <Button text="Process Return"
                            onAction="#processReturn"
                            styleClass="primary-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>